//// Generated by `npm run vectors` from cardano/evidence (BA955). Do not edit.
//// BA955: the real AeroDataBox Airnode signed "{'actual':'2026-10-30 21:47Z','scheduled':'2026-10-30 21:50Z','status':'Arrived'}" → payout none.

use aeroguard/cover.{Policy, Settle, settles}
use aeroguard/proof
use aiken/interval.{Finite, Interval, IntervalBound}
use cardano/address.{from_verification_key}
use cardano/assets.{from_lovelace}
use cardano/transaction.{
  InlineDatum, Output, OutputReference, Transaction, placeholder,
}

const airnode: ByteArray =
  #"0221225a114acb73845984f6b386cba8459ce7132b84174ac601a3c8665930862c"

const request: ByteArray =
  #"4b702f4f427c554273adfd8878668374e1d01d2063378548d4205a150d49de5b"

const holder: ByteArray =
  #"00000000000000000000000000000000000000000000000000000001"

const insurer: ByteArray =
  #"00000000000000000000000000000000000000000000000000000002"

const cover: Int = 10_000_000

const own: OutputReference =
  OutputReference {
    transaction_id: #"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    output_index: 0,
  }

fn policy() -> Policy {
  Policy {
    holder,
    insurer,
    airnode,
    arrival_request: request,
    status_request: request,
    scheduled: "2026-10-30 21:50Z",
    cover,
    deadline: 1_800_000_000_000,
    max_age: 3_600_000,
  }
}

fn settle() {
  Settle(
    1793399267,
    "Arrived",
    Some("2026-10-30 21:47Z"),
    #"8eb4fd8e7b1993fe939cf270bc16fdfa553e45457eae4d040ceaee4bf9d35aed4f4a6bcc9ab994624644d6f7421b2e2608ace5cf1571128c591f9cc2c338ce66",
  )
}

fn pay(to: ByteArray, amount: Int) -> Output {
  Output {
    address: from_verification_key(to),
    value: from_lovelace(amount),
    datum: InlineDatum(own),
    reference_script: None,
  }
}

fn tx(outputs: List<Output>) -> Transaction {
  Transaction {
    ..placeholder,
    outputs,
    validity_range: Interval {
      lower_bound: IntervalBound {
        bound_type: Finite(1793399267000),
        is_inclusive: True,
      },
      upper_bound: IntervalBound {
        bound_type: Finite(1793399867000),
        is_inclusive: True,
      },
    },
  }
}

test real_final_signature_verifies() {
  proof.verify(
    airnode,
    request,
    1793399267,
    proof.projected_data(
      "2026-10-30 21:50Z",
      "Arrived",
      Some("2026-10-30 21:47Z"),
    ),
    #"8eb4fd8e7b1993fe939cf270bc16fdfa553e45457eae4d040ceaee4bf9d35aed4f4a6bcc9ab994624644d6f7421b2e2608ace5cf1571128c591f9cc2c338ce66",
  )
}

test real_final_settles_by_the_rule() {
  settles(policy(), settle(), own, tx([pay(insurer, cover)]))
}

test real_final_wrong_payout_fails() fail {
  settles(policy(), settle(), own, tx([pay(holder, cover)]))
}
