{
  "name": "@aeroguard/cardano",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "npm --prefix ../keeper ci --no-audit --no-fund",
    "wallets": "node src/wallets.ts",
    "server": "node --env-file-if-exists=.env src/server.ts",
    "buy": "node --env-file-if-exists=.env src/buy.ts",
    "agent": "node --env-file-if-exists=.env src/agent.ts",
    "vectors": "node src/vectors.ts",
    "mcp": "node --env-file-if-exists=.env src/mcp.ts",
    "preflight": "node --env-file-if-exists=.env src/preflight.ts",
    "qualify": "node --env-file-if-exists=.env src/qualify.ts",
    "cover": "node --env-file-if-exists=.env src/cover-cli.ts",
    "import-evidence": "node src/import-evidence.ts",
    "balance": "node --env-file-if-exists=.env src/balance.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "buy-policy": "node --env-file-if-exists=.env src/buy-policy.ts",
    "server:policies": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/server.ts",
    "video": "sh video/src/render.sh"
  },
  "dependencies": {
    "@evolution-sdk/aiken-uplc": "^2.0.19",
    "@evolution-sdk/evolution": "^0.5.19",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^2.4.0",
    "@x402/cardano": "2.26.0",
    "@x402/core": "2.26.0",
    "@x402/express": "2.26.0",
    "@x402/fetch": "2.26.0",
    "express": "^4.21.2",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3"
  }
}
