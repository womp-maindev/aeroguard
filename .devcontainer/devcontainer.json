{
  // codespaces: dashboard runs on 8080 and opens by itself, no keys needed (it reads base sepolia from the browser).
  // keeper api on 8787 is optional: add KEEPER_PK + FLIGHT_COVER_ADDRESS as codespaces secrets, then `cd keeper && npm run api`
  "name": "AeroGuard",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "cd keeper && npm ci",
  "postAttachCommand": {
    "dashboard": "python3 -m http.server 8080 --directory web"
  },
  "forwardPorts": [8080, 8787],
  "portsAttributes": {
    "8080": { "label": "Dashboard", "onAutoForward": "openBrowser" },
    "8787": { "label": "Keeper API (optional)", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["web/README.md"] }
  }
}
