# Base Sepolia RPC
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Keeper wallet: pays gas, buys policies, settles (needs Base Sepolia ETH + aUSD)
KEEPER_PK=
# Optional separate wallet that pays AirnodeHub via x402 (needs aUSD only)
X402_PAYER_PK=
# Deployer (only for forge script)
DEPLOYER_PK=
FLIGHT_COVER_ADDRESS=0x257054204c4Cd43846C4553eBe6D709841980a80
# HTTP API + dashboard
PORT=8787
# on = also run the keeper loop in the API process. Leave off for the live contract: its keeper runs in GitHub Actions,
# and a second keeper would spend the AeroDataBox quota that every team shares.
KEEPER=off
# on = the dashboard gets a "Local rehearsal" section: one click starts a fresh anvil on :8545 and runs
# keeper/src/rehearse.ts (no keys, no funds, no lookups). It starts processes, so only on your own laptop.
REHEARSE=off
